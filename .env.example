# Optional: set this to enable live Gemini AI responses
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Database file path (default is project-root agrivanta.db)
AGRIVANTA_DB=agrivanta.db

# Password-reset email (optional; configure SMTP to email reset tokens)
APP_ENV=development
APP_BASE_URL=http://127.0.0.1:8000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
